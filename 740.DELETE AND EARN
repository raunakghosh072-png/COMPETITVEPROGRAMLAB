class Solution {
public:
    int deleteAndEarn(vector<int>& nums) {
        if (nums.empty()) return 0;
        
        int maxVal = 0;
        for (int num : nums) {
            maxVal = max(maxVal, num);
        }
        
        vector<int> sum(maxVal + 1, 0);
        for (int num : nums) {
            sum[num] += num;
        }
        
        int prev2 = 0;
        int prev1 = sum[0];
        
        for (int i = 1; i <= maxVal; ++i) {
            int current = max(prev1, prev2 + sum[i]);
            prev2 = prev1;
            prev1 = current;
        }
        
        return prev1;
    }
};
